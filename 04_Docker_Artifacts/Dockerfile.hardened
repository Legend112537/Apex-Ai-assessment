# syntax=docker/dockerfile:1.7
# Pin by digest in real use: python:3.12-slim-bookworm@sha256:<DIGEST_FROM_REGISTRY>
FROM python:3.12-slim-bookworm AS builder
ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /build
COPY requirements.lock .
# requirements.lock is generated with hashes (pip-compile --generate-hashes)
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --require-hashes -r requirements.lock

FROM python:3.12-slim-bookworm
RUN groupadd --gid 10001 app && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY --chown=10001:10001 src/ ./src/
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD ["python","-c","import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=2)"]
ENTRYPOINT ["python","-m","uvicorn","src.main:app","--host","0.0.0.0","--port","8000"]
